diff --git a/drivers/misc/tlbid_probe.c b/drivers/misc/tlbid_probe.c
new file mode 100644
index 0000000000000..ffba5a4ed958b
--- /dev/null
+++ b/drivers/misc/tlbid_probe.c
@@ -0,0 +1,445 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * tlbid_probe.c - FEAT_TLBID domain -> PE mapping probe
+ *
+ * Probes the hardware's execution of FEAT_TLBID domain semantics with
+ * "TLB-only sentinels": plant TLB entries of one shared ASID on several
+ * PEs, remove the page-table entry WITHOUT a TLBI, inject
+ * "tlbi aside1is" with a domain operand, then observe on each PE whether
+ * its sentinel survived (TLB hit = outside the domain, fault = inside).
+ * Iterating over all domains yields the complete domain -> PE map.
+ *
+ * Interface: insmod parameters only, no fs. The whole experiment runs
+ * synchronously inside module_init and prints results to dmesg, then
+ * returns -EAGAIN so the module unloads itself (repeatable insmod).
+ *
+ *   mode=scan                     iterate domain 0..2^NIS-1, print full map
+ *   mode=probe domain=D           probe a single domain
+ *   pes_mask=<u64 bitmap>         0 = all online CPUs (cap 64)
+ *
+ * Depends on the OpenEuler OLK-6.6 TLBID patch series providing
+ * system_supports_tlbid() and SYS_TLBIDIDR_EL1 (absent in mainline v7.3 -
+ * build against a tree that has them).
+ *
+ * Ambient-flush defence: before each injection the sentinels are verified
+ * to be in place; a lost sentinel before injection means the environment
+ * (vmalle1is-style full flush, ASID rollover, ...) destroyed it, so the
+ * round is retried instead of being misattributed to the hardware.
+ *
+ * The injecting PE is always flushed by TLBI (the local PE does not take
+ * part in domain matching) - its column is the built-in control.
+ */
+
+#define pr_fmt(fmt) "tlbid_probe: " fmt
+
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/kernel.h>
+#include <linux/kthread.h>
+#include <linux/completion.h>
+#include <linux/smp.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/sched/mm.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/pgtable.h>
+#include <asm/mmu.h>
+#include <asm/sysreg.h>
+#include <asm/cpufeature.h>
+#include <asm/tlbflush.h>
+#include <asm/pgtable.h>
+
+#define PROBE_MAX_PES		64
+
+static char *mode = "probe";
+module_param(mode, charp, 0444);
+MODULE_PARM_DESC(mode, "scan (all domains) | probe (single domain, see domain=)");
+
+static u32 domain;
+module_param(domain, uint, 0444);
+MODULE_PARM_DESC(domain, "domain value for mode=probe");
+
+static u64 pes_mask;
+module_param(pes_mask, ullong, 0444);
+MODULE_PARM_DESC(pes_mask, "bitmap of PEs to probe (bit N = CPU N); 0 = all online CPUs (max 64)");
+
+struct probe_pe {
+	int		cpu;
+	struct task_struct *tsk;
+	struct completion ready;	/* kthread up and armed */
+	struct completion go;		/* init -> kthread: access now */
+	struct completion done;		/* kthread -> init: access finished */
+	bool		fault;		/* last access faulted (entry gone) */
+};
+
+static struct {
+	struct mm_struct *mm;		/* shared guard mm: one ASID for all PEs */
+	unsigned long	addr;		/* probe page, user mapping of guard mm */
+	pte_t		*ptep;		/* its PTE (TLB-only surgery) */
+	spinlock_t	*ptl;
+	pte_t		orig_pte;	/* restored for each arm */
+	unsigned long	asid;		/* refreshed per round */
+	int		injector;	/* index into pes[], issuing PE */
+	struct probe_pe *pes;
+	int		nr_pes;
+} st;
+
+/*
+ * Access the probe page; returns false if the access faulted.
+ * The __ex_table fixup catches EL1 data aborts (do_el1_fault consults
+ * fixup_exception), unlike UNDEFINED - this is the observation channel.
+ */
+static bool access_probe(unsigned long addr)
+{
+	bool ok;
+	unsigned long tmp;
+
+	asm volatile(
+	"0:	ldr	%w1, [%2]\n"
+	"	mov	%w0, #1\n"
+	"	b	2f\n"
+	"1:	mov	%w0, #0\n"
+	"2:\n"
+	"	.pushsection __ex_table,\"a\"\n"
+	"	.long	0b, 1b\n"
+	"	.popsection\n"
+	: "=r" (ok), "=&r" (tmp) : "r" (addr) : "memory");
+	(void)tmp;
+	return ok;
+}
+
+/*
+ * pes[0] runs this before signalling ready: it maps the probe page into
+ * the guard mm, faults it in (creating the PTE) and locates the PTE.
+ */
+static int guard_setup(void)
+{
+	unsigned long addr;
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *ptep;
+	spinlock_t *ptl;
+
+	addr = vm_mmap(NULL, 0, PAGE_SIZE, PROT_READ | PROT_WRITE,
+		       MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	if (IS_ERR_VALUE(addr))
+		return PTR_ERR((void *)addr);
+	st.addr = addr;
+
+	/* Fault the page in: the PTE now exists and is valid. */
+	if (!access_probe(addr))
+		return -EIO;
+
+	mmap_read_lock(st.mm);
+	pgd = pgd_offset(st.mm, addr);
+	p4d = p4d_offset(pgd, addr);
+	pud = pud_alloc(st.mm, p4d, addr);
+	if (!pud) {
+		mmap_read_unlock(st.mm);
+		return -ENOMEM;
+	}
+	pmd = pmd_alloc(st.mm, pud, addr);
+	if (!pmd) {
+		mmap_read_unlock(st.mm);
+		return -ENOMEM;
+	}
+	ptep = pte_offset_map_lock(st.mm, pmd, addr, &ptl);
+	if (!ptep) {
+		mmap_read_unlock(st.mm);
+		return -EIO;
+	}
+	st.orig_pte = *ptep;
+	st.ptep = ptep;
+	st.ptl = ptl;
+	mmap_read_unlock(st.mm);
+	return 0;
+}
+
+static int pe_thread(void *arg)
+{
+	struct probe_pe *pe = arg;
+	int ret = 0;
+
+	/* Assigns the guard mm's ASID on this PE (check_and_switch_context). */
+	kthread_use_mm(st.mm);
+
+	if (pe == &st.pes[0]) {
+		ret = guard_setup();
+		if (ret)
+			pr_err("guard setup failed on cpu%d: %d\n", pe->cpu, ret);
+	}
+	complete(&pe->ready);
+
+	/*
+	 * Interruptible wait: kthread_stop() raises TIF_NOTIFY_SIGNAL,
+	 * which releases us from the wait even if the teardown completion
+	 * raced with us re-entering it.
+	 */
+	while (!kthread_should_stop()) {
+		wait_for_completion_interruptible(&pe->go);
+		if (kthread_should_stop())
+			break;
+		pe->fault = !access_probe(st.addr);
+		complete(&pe->done);
+	}
+
+	kthread_unuse_mm(st.mm, NULL);
+	return ret;
+}
+
+/* Poke all PE kthreads, wait, return their fault flags in @faults. */
+static void poke_and_wait(bool *faults)
+{
+	int i;
+
+	for (i = 0; i < st.nr_pes; i++) {
+		reinit_completion(&st.pes[i].done);
+		complete(&st.pes[i].go);
+	}
+	for (i = 0; i < st.nr_pes; i++) {
+		wait_for_completion(&st.pes[i].done);
+		faults[i] = st.pes[i].fault;
+	}
+}
+
+/*
+ * Arm: restore the PTE (identical value -> existing TLB entries still
+ * hit, no TLBI needed), fill every PE's TLB, verify all sentinels are in
+ * place, then remove the PTE (TLB-only). Returns 0 on success, -1 if the
+ * environment flushed the sentinels (round must be retried).
+ */
+static int arm_and_verify(void)
+{
+	bool faults[PROBE_MAX_PES];
+	int tries;
+
+	for (tries = 0; tries < 3; tries++) {
+		mmap_read_lock(st.mm);
+		spin_lock(st.ptl);
+		set_pte(st.ptep, st.orig_pte);
+		spin_unlock(st.ptl);
+		mmap_read_unlock(st.mm);
+		dsb(ishst);
+
+		poke_and_wait(faults);
+
+		if (memchr_inv(faults, 0, st.nr_pes))
+			continue;	/* something flushed us: re-arm */
+
+		/* All sentinels in place: cut the page table, no TLBI. */
+		mmap_read_lock(st.mm);
+		spin_lock(st.ptl);
+		pte_clear(st.mm, st.addr, st.ptep);
+		spin_unlock(st.ptl);
+		mmap_read_unlock(st.mm);
+		dsb(ishst);
+		return 0;
+	}
+
+	pr_err("ambient flush detected %d times, round aborted\n", tries);
+	return -1;
+}
+
+static void do_inject(void *arg)
+{
+	u64 d = *(u64 *)arg;
+	u64 operand = (st.asid << 48) | (d & GENMASK_ULL(15, 0));
+
+	dsb(ishst);
+	asm volatile("tlbi aside1is, %0" :: "r"(operand));
+	dsb(ish);
+	isb();
+}
+
+static int round(u64 d, bool *faults)
+{
+	int ret;
+
+	st.asid = ASID(st.mm);
+
+	ret = arm_and_verify();
+	if (ret)
+		return ret;
+
+	ret = smp_call_function_single(st.pes[st.injector].cpu, do_inject, &d, 1);
+	if (ret)
+		return ret;
+
+	poke_and_wait(faults);
+	return 0;
+}
+
+static void report_row(u64 d, bool *faults)
+{
+	unsigned long map[BITS_TO_LONGS(PROBE_MAX_PES)] = { 0 };
+	int i;
+
+	for (i = 0; i < st.nr_pes; i++)
+		if (faults[i])
+			__set_bit(st.pes[i].cpu, map);
+
+	pr_info("domain=%#llx pes=%*pb\n", d, st.nr_pes, map);
+}
+
+static int run_scan(u32 nis)
+{
+	u64 max_domains = 1ULL << min(nis, 16);
+	bool faults[PROBE_MAX_PES];
+	u64 d;
+
+	pr_info("scan: nis=%u domains=%#llx pes=%d asid=%#lx injector=cpu%d\n",
+		nis, max_domains, st.nr_pes, (unsigned long)ASID(st.mm),
+		st.pes[st.injector].cpu);
+
+	for (d = 0; d < max_domains; d++) {
+		if (round(d, faults))
+			continue;
+		report_row(d, faults);
+	}
+
+	pr_info("scan done\n");
+	return 0;
+}
+
+static int run_probe(u64 d)
+{
+	bool faults[PROBE_MAX_PES];
+	int ret;
+
+	pr_info("probe: domain=%#llx pes=%d asid=%#lx injector=cpu%d\n",
+		d, st.nr_pes, (unsigned long)ASID(st.mm), st.pes[st.injector].cpu);
+
+	ret = round(d, faults);
+	if (ret)
+		return ret;
+
+	report_row(d, faults);
+	return 0;
+}
+
+static void teardown(void)
+{
+	int i;
+
+	for (i = 0; i < st.nr_pes; i++) {
+		complete(&st.pes[i].go);
+		if (st.pes[i].tsk)
+			kthread_stop(st.pes[i].tsk);
+	}
+	if (st.mm)
+		mmput(st.mm);
+	kfree(st.pes);
+	st.pes = NULL;
+	st.mm = NULL;
+}
+
+static int __init tlbid_probe_init(void)
+{
+	u64 tlbididr;
+	u32 nis;
+	int i, ret;
+
+	if (!system_supports_tlbid()) {
+		pr_err("FEAT_TLBID not supported on this CPU\n");
+		return -ENODEV;
+	}
+
+	tlbididr = read_sysreg_s(SYS_TLBIDIDR_EL1);
+	nis = FIELD_GET(GENMASK(4, 0), tlbididr);
+	pr_info("TLBIDIDR_EL1=%#llx nis=%u nvis=%u nos=%u nvos=%u\n",
+		tlbididr, nis,
+		(u32)FIELD_GET(GENMASK(12, 8), tlbididr),
+		(u32)FIELD_GET(GENMASK(36, 32), tlbididr),
+		(u32)FIELD_GET(GENMASK(44, 40), tlbididr));
+
+	/* Build the PE list from pes_mask, or all online CPUs. */
+	st.nr_pes = 0;
+	for_each_online_cpu(i) {
+		if (st.nr_pes >= PROBE_MAX_PES)
+			break;
+		if (pes_mask && !(pes_mask & BIT_ULL(i)))
+			continue;
+		st.nr_pes++;
+	}
+	if (!st.nr_pes) {
+		pr_err("no PEs selected\n");
+		return -EINVAL;
+	}
+
+	st.pes = kcalloc(st.nr_pes, sizeof(*st.pes), GFP_KERNEL);
+	if (!st.pes)
+		return -ENOMEM;
+
+	st.mm = mm_alloc(&init_mm);
+	if (!st.mm) {
+		kfree(st.pes);
+		return -ENOMEM;
+	}
+
+	st.nr_pes = 0;
+	for_each_online_cpu(i) {
+		struct probe_pe *pe;
+
+		if (st.nr_pes >= PROBE_MAX_PES)
+			break;
+		if (pes_mask && !(pes_mask & BIT_ULL(i)))
+			continue;
+
+		pe = &st.pes[st.nr_pes++];
+		pe->cpu = i;
+		init_completion(&pe->ready);
+		init_completion(&pe->go);
+		init_completion(&pe->done);
+		/*
+		 * kthread_create() + kthread_bind() before wake_up_process():
+		 * binding after kthread_run() would race with the thread
+		 * already running (and possibly finishing) on a wrong CPU.
+		 */
+		pe->tsk = kthread_create(pe_thread, pe, "tlbid_probe/%d", i);
+		if (IS_ERR(pe->tsk)) {
+			ret = PTR_ERR(pe->tsk);
+			pe->tsk = NULL;
+			teardown();
+			return ret;
+		}
+		kthread_bind(pe->tsk, i);
+		wake_up_process(pe->tsk);
+	}
+
+	/* pes[0] sets up the guard mm mapping; wait for all to be ready. */
+	for (i = 0; i < st.nr_pes; i++)
+		wait_for_completion(&st.pes[i].ready);
+
+	if (st.ptep == NULL) {
+		pr_err("guard setup failed\n");
+		teardown();
+		return -EIO;
+	}
+
+	st.injector = 0;
+
+	if (!strcmp(mode, "scan"))
+		ret = run_scan(nis);
+	else if (!strcmp(mode, "probe"))
+		ret = run_probe(domain);
+	else {
+		pr_err("unknown mode '%s' (scan|probe)\n", mode);
+		ret = -EINVAL;
+	}
+
+	teardown();
+
+	/*
+	 * Deliberately fail init so the module unloads itself: insmod
+	 * reports an error but the results are in dmesg and the next insmod
+	 * with different parameters works immediately.
+	 */
+	return -EAGAIN;
+}
+module_init(tlbid_probe_init);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("FEAT_TLBID domain -> PE mapping probe");
