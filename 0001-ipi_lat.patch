diff --git a/drivers/misc/ipi_lat.c b/drivers/misc/ipi_lat.c
new file mode 100644
index 000000000000..0e3b1b317e54
--- /dev/null
+++ b/drivers/misc/ipi_lat.c
@@ -0,0 +1,645 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ipi_lat.c - arm64 IPI latency measurement driver (Linux 6.6 port)
+ *
+ * Measures the software-visible one-way IPI latency between two CPUs using
+ * the kernel's real cross-CPU notification paths:
+ *
+ *   csd      : smp_call_function_single(wait=1)  (IPI_CALL_FUNC)
+ *   self     : smp_call_function_single to the *current* CPU - negative
+ *              control: generic_exec_single() runs the callback inline
+ *              with IRQs masked and NO interrupt is sent at all
+ *              (kernel/smp.c:390-408 in 6.6).
+ *
+ * Design invariant: every sample that enters the statistics must have seen
+ * a real interrupt delivery between t0 and the callback execution.  This
+ * is enforced per iteration by comparing the target CPU's IPI_CALL_FUNC
+ * kstat counter before/after the call: handle_percpu_devid_irq() increments
+ * it (kernel/irq/chip.c:902 in 6.6) BEFORE the callback chain runs, so
+ * after == before means our csd was batched onto somebody else's
+ * already-pending IPI (llist_add() returned false in kernel/smp.c:427-428)
+ * and the sample is discarded.
+ *
+ * NOTE for 6.6: unlike newer kernels, arm64 in 6.6 DOES define
+ * TIF_POLLING_NRFLAG (arch/arm64/include/asm/thread_info.h:79), so
+ * call_function_single_prep_ipi() (kernel/sched/core.c:3776) can skip the
+ * IPI for an idle polling target.  Two layers protect the measurement:
+ *   1. busy=1 (default) keeps the target CPU spinning with IRQs enabled,
+ *      so it is never idle and the bypass cannot trigger;
+ *   2. even if busy=0, the kstat judgment above discards every sample
+ *      serviced without an interrupt delivery.
+ *
+ * Interface: debugfs /sys/kernel/debug/ipi_lat/{mode,sender_cpu,target_cpu,
+ * iterations,warmup,pace_ns,busy,run,results}.
+ */
+
+#define pr_fmt(fmt) "ipi_lat: " fmt
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/debugfs.h>
+#include <linux/kthread.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/smp.h>
+#include <linux/irq.h>
+#include <linux/irqdesc.h>
+#include <linux/irqnr.h>
+#include <linux/cpumask.h>
+#include <linux/percpu.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+#include <linux/string.h>
+#include <linux/math64.h>
+#include <linux/mutex.h>
+#include <linux/uaccess.h>
+#include <asm/arch_timer.h>
+
+#define IPI_LAT_IPI_CALL_FUNC	1	/* IPI_CALL_FUNC index (arm64 smp.c:75) */
+#define IPI_LAT_MIN_IPI_IRQS	7	/* NR_IPI on 6.6 arm64 (no SMT_QOS) */
+#define IPI_LAT_MAX_ITERATIONS	1000000U
+#define IPI_LAT_HIST_BINS	64
+#define IPI_LAT_HIST_BIN_NS	10
+#define IPI_LAT_RESULTS_SZ	8192
+
+enum ipi_lat_mode {
+	IPI_LAT_MODE_CSD,
+	IPI_LAT_MODE_SELF,
+};
+
+static const char * const ipi_lat_mode_names[] = {
+	[IPI_LAT_MODE_CSD]	= "csd",
+	[IPI_LAT_MODE_SELF]	= "self",
+};
+
+/* --- global state, serialized by ipi_lat_run_mutex for run/results --- */
+static DEFINE_MUTEX(ipi_lat_run_mutex);
+static DEFINE_PER_CPU(u64, ipi_lat_handled);
+
+static struct dentry *ipi_lat_dir;
+
+static char ipi_lat_mode[32] = "csd";
+static unsigned int ipi_lat_sender;
+static unsigned int ipi_lat_target = 1;
+static unsigned int ipi_lat_iterations = 100000;
+static unsigned int ipi_lat_warmup = 1000;
+static unsigned int ipi_lat_pace_ns;
+static bool ipi_lat_busy = true;
+
+static char *ipi_lat_results_buf;
+static size_t ipi_lat_results_len;
+
+/* --- IPI irq discovery (arm64 registers all IPIs with name "IPI") ---
+ * On 6.6 the GIC allocates 8 contiguous SGI virqs (irq-gic-v3.c:1762) and
+ * arm64 requests nr_ipi of them as percpu irqs named "IPI" in enum order
+ * (arch/arm64/kernel/smp.c:1036-1056).  IPI_CALL_FUNC is index 1 and
+ * IPI_IRQ_WORK is index 5 of the contiguous run.
+ */
+static unsigned int ipi_lat_ipi_nr;
+static unsigned int *ipi_lat_ipi_irqs;
+static const char *ipi_lat_chip_name;
+
+static struct irq_desc *ipi_lat_desc(unsigned int ipi)
+{
+	return irq_to_desc(ipi_lat_ipi_irqs[ipi]);
+}
+
+static int ipi_lat_discover_ipis(void)
+{
+	/* 6.6 has no irq_get_nr_irqs() accessor; nr_irqs is GPL-exported */
+	unsigned int nr = nr_irqs;
+	unsigned int *irqs;
+	unsigned int i, n = 0;
+	struct irq_chip *chip = NULL;
+
+	irqs = kmalloc_array(nr, sizeof(*irqs), GFP_KERNEL);
+	if (!irqs)
+		return -ENOMEM;
+
+	for (i = 0; i < nr; i++) {
+		struct irq_desc *desc = irq_to_desc(i);
+		struct irq_chip *c;
+
+		if (!desc || !desc->action)
+			continue;
+		if (strcmp(desc->action->name, "IPI"))
+			continue;
+		c = irq_desc_get_chip(desc);
+		if (!c || (!c->ipi_send_mask && !c->ipi_send_single))
+			continue;
+		irqs[n++] = i;
+		if (!chip)
+			chip = c;
+	}
+
+	/* Expect one contiguous ascending run of IPI irqs (SGI mode). */
+	for (i = 1; i < n; i++) {
+		if (irqs[i] != irqs[0] + i) {
+			pr_err("IPI irqs are not contiguous (irq[%u]=%u)\n",
+			       i, irqs[i]);
+			kfree(irqs);
+			return -ENODEV;
+		}
+	}
+	if (n < IPI_LAT_MIN_IPI_IRQS) {
+		pr_err("found %u IPI irqs, need at least %u (unsupported platform)\n",
+		       n, IPI_LAT_MIN_IPI_IRQS);
+		kfree(irqs);
+		return -ENODEV;
+	}
+
+	ipi_lat_ipi_nr = n;
+	ipi_lat_ipi_irqs = irqs;
+	ipi_lat_chip_name = chip->name;
+
+	pr_info("%u contiguous IPI irqs (SGI mode), chip %s\n", n, chip->name);
+	return 0;
+}
+
+/* --- clock: arm64 physical counter, shared by all PEs --- */
+static u32 ipi_lat_cntfrq;
+
+static inline u64 ipi_lat_clock(void)
+{
+	return __arch_counter_get_cntpct();
+}
+
+static inline u64 ipi_lat_ticks_to_ns(u64 ticks)
+{
+	return mul_u64_u32_div(ticks, NSEC_PER_SEC, ipi_lat_cntfrq);
+}
+
+/* --- statistics --- */
+struct ipi_lat_stats {
+	u64 *samples;
+	unsigned int cap;
+	unsigned int valid;
+	u64 sum_ticks;
+	u64 min_ticks;
+	u64 max_ticks;
+	u64 hist[IPI_LAT_HIST_BINS];
+	u64 hist_overflow;
+};
+
+static void ipi_lat_stats_add(struct ipi_lat_stats *st, u64 ticks)
+{
+	u64 ns;
+	unsigned int bin;
+
+	if (WARN_ON_ONCE(st->valid >= st->cap))
+		return;
+
+	st->samples[st->valid++] = ticks;
+	st->sum_ticks += ticks;
+	if (ticks < st->min_ticks)
+		st->min_ticks = ticks;
+	if (ticks > st->max_ticks)
+		st->max_ticks = ticks;
+
+	ns = ipi_lat_ticks_to_ns(ticks);
+	bin = div_u64(ns, IPI_LAT_HIST_BIN_NS);
+	if (bin >= IPI_LAT_HIST_BINS) {
+		st->hist_overflow++;
+		bin = IPI_LAT_HIST_BINS - 1;
+	}
+	st->hist[bin]++;
+}
+
+static int ipi_lat_cmp(const void *a, const void *b)
+{
+	u64 x = *(const u64 *)a;
+	u64 y = *(const u64 *)b;
+
+	if (x < y)
+		return -1;
+	if (x > y)
+		return 1;
+	return 0;
+}
+
+/* --- run state / handlers --- */
+struct ipi_lat_run {
+	struct completion done;
+	enum ipi_lat_mode mode;
+	unsigned int sender;
+	unsigned int target;
+	unsigned int iterations;
+	unsigned int warmup;
+	unsigned int pace_ns;
+	bool busy;
+	int err;
+	unsigned int discarded;
+	u64 handled_delta;
+	u64 kstat_delta;
+	struct ipi_lat_stats st;
+};
+
+struct ipi_lat_iter {
+	u64 t0, t1;
+	int cpu;
+};
+
+static void ipi_lat_csd_handler(void *info)
+{
+	struct ipi_lat_iter *iter = info;
+
+	iter->t1 = ipi_lat_clock();	/* first instruction: stamp arrival */
+	iter->cpu = smp_processor_id();
+	this_cpu_inc(ipi_lat_handled);
+}
+
+/* --- busy kthread: keeps the target CPU out of idle.  Required on 6.6:
+ * arm64 has TIF_POLLING_NRFLAG, so an idle target could be woken without
+ * an IPI (call_function_single_prep_ipi bypass); busy=1 prevents that.
+ */
+static int ipi_lat_busy_thread(void *data)
+{
+	while (!kthread_should_stop())
+		cpu_relax();
+	return 0;
+}
+
+static struct task_struct *ipi_lat_busy_start(unsigned int cpu)
+{
+	struct task_struct *task;
+
+	task = kthread_create(ipi_lat_busy_thread, NULL, "ipi_lat-busy/%u", cpu);
+	if (IS_ERR(task))
+		return task;
+	kthread_bind(task, cpu);
+	wake_up_process(task);
+	return task;
+}
+
+/* --- measurement loops --- */
+static void ipi_lat_run_csd(struct ipi_lat_run *r, struct irq_desc *cf_desc)
+{
+	struct ipi_lat_iter iter;
+	unsigned int valid = 0;
+
+	while (valid < r->warmup + r->iterations) {
+		unsigned int before, after;
+
+		if (unlikely(!cpu_online(r->target))) {
+			r->err = -ENXIO;
+			return;
+		}
+
+		iter.t0 = ipi_lat_clock();
+		/* before must be read AFTER t0 so that any after > before
+		 * corresponds to an interrupt delivered after t0.
+		 */
+		before = irq_desc_kstat_cpu(cf_desc, r->target);
+		smp_call_function_single(r->target, ipi_lat_csd_handler, &iter, 1);
+		after = irq_desc_kstat_cpu(cf_desc, r->target);
+
+		if (r->pace_ns)
+			fsleep(r->pace_ns);
+
+		if (after == before) {
+			/* No interrupt was delivered in the window: our csd
+			 * was batched onto an already-pending IPI (or, on 6.6,
+			 * an idle target was woken via the polling shortcut).
+			 * Discard.
+			 */
+			r->discarded++;
+			continue;
+		}
+		if (++valid > r->warmup)
+			ipi_lat_stats_add(&r->st, iter.t1 - iter.t0);
+	}
+}
+
+static void ipi_lat_run_self(struct ipi_lat_run *r)
+{
+	struct ipi_lat_iter iter;
+	unsigned int valid = 0;
+
+	/* Negative control: generic_exec_single() runs the callback inline
+	 * on the caller (kernel/smp.c:390-408).  No IPI is expected, no
+	 * kstat judgment - the whole point is to measure the bypass.
+	 */
+	while (valid < r->warmup + r->iterations) {
+		iter.t0 = ipi_lat_clock();
+		smp_call_function_single(r->sender, ipi_lat_csd_handler, &iter, 1);
+
+		if (r->pace_ns)
+			fsleep(r->pace_ns);
+
+		if (++valid > r->warmup)
+			ipi_lat_stats_add(&r->st, iter.t1 - iter.t0);
+	}
+}
+
+static int ipi_lat_run_thread(void *data)
+{
+	struct ipi_lat_run *r = data;
+	struct irq_desc *cf_target;
+	unsigned int kstat_start, kstat_end;
+	unsigned long handled_start;
+	struct task_struct *busy = NULL;
+
+	cf_target = ipi_lat_desc(IPI_LAT_IPI_CALL_FUNC);
+	if (!cf_target) {
+		r->err = -ENODEV;
+		goto out;
+	}
+
+	if (r->busy && r->mode != IPI_LAT_MODE_SELF) {
+		busy = ipi_lat_busy_start(r->target);
+		if (IS_ERR(busy)) {
+			pr_warn("failed to start busy thread (%ld)\n",
+				PTR_ERR(busy));
+			busy = NULL;
+		}
+	}
+
+	kstat_start = irq_desc_kstat_cpu(cf_target, r->target);
+	handled_start = per_cpu(ipi_lat_handled, r->target);
+
+	switch (r->mode) {
+	case IPI_LAT_MODE_CSD:
+		ipi_lat_run_csd(r, cf_target);
+		break;
+	case IPI_LAT_MODE_SELF:
+		ipi_lat_run_self(r);
+		break;
+	}
+
+	kstat_end = irq_desc_kstat_cpu(cf_target, r->target);
+	r->kstat_delta = kstat_end - kstat_start;
+	r->handled_delta = per_cpu(ipi_lat_handled, r->target) - handled_start;
+
+	if (busy)
+		kthread_stop(busy);
+out:
+	complete(&r->done);
+	return 0;
+}
+
+/* --- run setup / results --- */
+static enum ipi_lat_mode ipi_lat_mode_parse(void)
+{
+	if (!strcmp(ipi_lat_mode, "self"))
+		return IPI_LAT_MODE_SELF;
+	return IPI_LAT_MODE_CSD;
+}
+
+static int ipi_lat_prepare_run(struct ipi_lat_run *r)
+{
+	r->mode = ipi_lat_mode_parse();
+	r->sender = ipi_lat_sender;
+	r->target = ipi_lat_target;
+	r->iterations = ipi_lat_iterations;
+	r->warmup = ipi_lat_warmup;
+	r->pace_ns = ipi_lat_pace_ns;
+	r->busy = ipi_lat_busy;
+
+	if (r->iterations == 0 || r->iterations > IPI_LAT_MAX_ITERATIONS)
+		return -EINVAL;
+	if (r->warmup > r->iterations)
+		return -EINVAL;
+	if (!cpu_online(r->sender))
+		return -EINVAL;
+
+	if (r->mode == IPI_LAT_MODE_SELF) {
+		/* Negative control: run against the sender itself. */
+		r->target = r->sender;
+	} else {
+		if (!cpu_online(r->target))
+			return -EINVAL;
+		if (r->sender == r->target) {
+			pr_err("sender == target is the inline fast path; use mode=csd with different CPUs, or mode=self for the negative control\n");
+			return -EINVAL;
+		}
+	}
+	return 0;
+}
+
+static int ipi_lat_build_results(struct ipi_lat_run *r)
+{
+	char *buf;
+	int pos = 0;
+	unsigned int valid = r->st.valid;
+	u64 avg;
+	int i;
+
+	buf = kzalloc(IPI_LAT_RESULTS_SZ, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "mode=%s sender=%u target=%u\n",
+			 ipi_lat_mode_names[r->mode], r->sender, r->target);
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "chip=%s iterations=%u warmup=%u pace_ns=%u\n",
+			 ipi_lat_chip_name, r->iterations, r->warmup, r->pace_ns);
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "cntfrq=%u Hz ticks=%llu valid=%u discarded=%u (%.2f%%)\n",
+			 ipi_lat_cntfrq, ipi_lat_clock(),
+			 valid, r->discarded,
+			 valid + r->discarded ?
+			 100.0 * r->discarded / (valid + r->discarded) : 0.0);
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "handled=%llu expect=%u %s\n",
+			 r->handled_delta, valid + r->discarded,
+			 r->handled_delta == valid + r->discarded ? "OK" : "MISMATCH");
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "kstat_delta=%llu expect>=%u %s\n",
+			 r->kstat_delta, valid,
+			 r->kstat_delta >= valid ? "OK" : "FAIL");
+
+	if (strstr(saved_command_line, "threadirqs"))
+		pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+				 "WARNING: threadirqs on cmdline - IPI handlers may be threaded, results invalid\n");
+
+	if (r->mode == IPI_LAT_MODE_SELF)
+		pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+				 "self mode: inline fast path expected (<100ns, no IPI); kstat_delta above is third-party IPIs only\n");
+
+	if (!valid)
+		goto out;
+
+	sort(r->st.samples, valid, sizeof(u64), ipi_lat_cmp, NULL);
+	avg = ipi_lat_ticks_to_ns(div_u64(r->st.sum_ticks, valid));
+
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "min=%lluns (%llu ticks)\navg=%lluns\nmax=%lluns (%llu ticks)\n",
+			 ipi_lat_ticks_to_ns(r->st.min_ticks), r->st.min_ticks,
+			 avg,
+			 ipi_lat_ticks_to_ns(r->st.max_ticks), r->st.max_ticks);
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "p50=%lluns p95=%lluns p99=%lluns\n",
+			 ipi_lat_ticks_to_ns(r->st.samples[(u64)(valid - 1) * 50 / 100]),
+			 ipi_lat_ticks_to_ns(r->st.samples[(u64)(valid - 1) * 95 / 100]),
+			 ipi_lat_ticks_to_ns(r->st.samples[(u64)(valid - 1) * 99 / 100]));
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 "hist(%uns/bin):", IPI_LAT_HIST_BIN_NS);
+	for (i = 0; i < IPI_LAT_HIST_BINS; i++)
+		pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+				 " %llu", r->st.hist[i]);
+	pos += scnprintf(buf + pos, IPI_LAT_RESULTS_SZ - pos,
+			 " overflow=%llu\n", r->st.hist_overflow);
+
+out:
+	kfree(ipi_lat_results_buf);
+	ipi_lat_results_buf = buf;
+	ipi_lat_results_len = pos;
+	return 0;
+}
+
+/* --- debugfs interface --- */
+static ssize_t ipi_lat_mode_read(struct file *file, char __user *ubuf,
+				 size_t count, loff_t *ppos)
+{
+	return simple_read_from_buffer(ubuf, count, ppos,
+				       ipi_lat_mode, strlen(ipi_lat_mode));
+}
+
+static ssize_t ipi_lat_mode_write(struct file *file, const char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	char buf[32];
+	int i;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	for (i = 0; buf[i]; i++) {
+		if (buf[i] == '\n' || buf[i] == ' ') {
+			buf[i] = '\0';
+			break;
+		}
+	}
+	if (strcmp(buf, "csd") && strcmp(buf, "self"))
+		return -EINVAL;
+
+	if (mutex_lock_interruptible(&ipi_lat_run_mutex))
+		return -ERESTARTSYS;
+	strscpy(ipi_lat_mode, buf, sizeof(ipi_lat_mode));
+	mutex_unlock(&ipi_lat_run_mutex);
+	return count;
+}
+
+static ssize_t ipi_lat_run_write(struct file *file, const char __user *ubuf,
+				 size_t count, loff_t *ppos)
+{
+	struct ipi_lat_run run = { };
+	struct task_struct *task;
+	int err;
+
+	if (mutex_lock_interruptible(&ipi_lat_run_mutex))
+		return -ERESTARTSYS;
+
+	err = ipi_lat_prepare_run(&run);
+	if (err)
+		goto unlock;
+
+	run.st.samples = kmalloc_array(run.iterations, sizeof(u64), GFP_KERNEL);
+	if (!run.st.samples) {
+		err = -ENOMEM;
+		goto unlock;
+	}
+	run.st.cap = run.iterations;
+	run.st.min_ticks = U64_MAX;
+
+	init_completion(&run.done);
+	task = kthread_create(ipi_lat_run_thread, &run, "ipi_lat-run");
+	if (IS_ERR(task)) {
+		err = PTR_ERR(task);
+		goto free_samples;
+	}
+	kthread_bind(task, run.sender);
+	wake_up_process(task);
+	wait_for_completion(&run.done);
+
+	err = run.err;
+	if (!err)
+		err = ipi_lat_build_results(&run);
+free_samples:
+	kfree(run.st.samples);
+unlock:
+	mutex_unlock(&ipi_lat_run_mutex);
+	return err ? err : count;
+}
+
+static ssize_t ipi_lat_results_read(struct file *file, char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	if (!ipi_lat_results_buf)
+		return -EINVAL;
+	return simple_read_from_buffer(ubuf, count, ppos,
+				       ipi_lat_results_buf,
+				       ipi_lat_results_len);
+}
+
+static const struct file_operations ipi_lat_mode_fops = {
+	.read	= ipi_lat_mode_read,
+	.write	= ipi_lat_mode_write,
+};
+
+static const struct file_operations ipi_lat_run_fops = {
+	.write	= ipi_lat_run_write,
+};
+
+static const struct file_operations ipi_lat_results_fops = {
+	.read	= ipi_lat_results_read,
+};
+
+static int __init ipi_lat_init(void)
+{
+	int err;
+
+	ipi_lat_cntfrq = arch_timer_get_cntfrq();
+	if (!ipi_lat_cntfrq) {
+		pr_err("arch timer frequency not available\n");
+		return -ENODEV;
+	}
+
+	err = ipi_lat_discover_ipis();
+	if (err)
+		return err;
+
+	ipi_lat_dir = debugfs_create_dir("ipi_lat", NULL);
+	if (!ipi_lat_dir)
+		goto err_ipis;
+
+	debugfs_create_file("mode", 0644, ipi_lat_dir, NULL, &ipi_lat_mode_fops);
+	debugfs_create_u32("sender_cpu", 0644, ipi_lat_dir, &ipi_lat_sender);
+	debugfs_create_u32("target_cpu", 0644, ipi_lat_dir, &ipi_lat_target);
+	debugfs_create_u32("iterations", 0644, ipi_lat_dir, &ipi_lat_iterations);
+	debugfs_create_u32("warmup", 0644, ipi_lat_dir, &ipi_lat_warmup);
+	debugfs_create_u32("pace_ns", 0644, ipi_lat_dir, &ipi_lat_pace_ns);
+	debugfs_create_bool("busy", 0644, ipi_lat_dir, &ipi_lat_busy);
+	debugfs_create_file("run", 0200, ipi_lat_dir, NULL, &ipi_lat_run_fops);
+	debugfs_create_file("results", 0444, ipi_lat_dir, NULL,
+			    &ipi_lat_results_fops);
+
+	pr_info("ready (chip=%s, SGI mode, cntfrq=%u Hz)\n",
+		ipi_lat_chip_name, ipi_lat_cntfrq);
+	return 0;
+
+err_ipis:
+	kfree(ipi_lat_ipi_irqs);
+	return -ENODEV;
+}
+
+static void __exit ipi_lat_exit(void)
+{
+	debugfs_remove_recursive(ipi_lat_dir);
+	kfree(ipi_lat_ipi_irqs);
+	kfree(ipi_lat_results_buf);
+	pr_info("removed\n");
+}
+
+module_init(ipi_lat_init);
+module_exit(ipi_lat_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("arm64 IPI latency measurement driver (6.6 port)");
+MODULE_AUTHOR("Jin");
